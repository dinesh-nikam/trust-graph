# ==============================================================================
# TrustGraph — Production-Ready .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ------------------------------------------------------------------------------
# Build & Distribution Artifacts
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.next/
.output/

# TypeScript build cache and compiled config artifacts
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL per AGENTS.md Rule 36)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# Private keys, certificates, secrets & wallets
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets.json
mnemonic.txt
keystore/

# ------------------------------------------------------------------------------
# Smart Contract & Web3 Tooling (Hardhat / Foundry / Truffle / TypeChain)
# ------------------------------------------------------------------------------
artifacts/
cache/
cache_forge/
broadcast/
typechain/
typechain-types/

# Test coverage reports
coverage/
coverage.json
*.lcov
.nyc_output/

# ------------------------------------------------------------------------------
# Logs & Diagnostic Files
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# IDE & Editor Directories
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------------------
# Operating System Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# Agent, Indexer & Local Tooling Caches
# ------------------------------------------------------------------------------
.codegraph/
.omo/
.turbo/
.cache/
.e2e/
tmp/
temp/
