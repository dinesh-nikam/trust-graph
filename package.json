{
  "name": "trustgraph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "compile": "hardhat compile",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:coverage": "hardhat test --coverage",
    "contracts:deploy:testnet": "hardhat run scripts/deploy.ts --network monadTestnet",
    "contracts:check:testnet": "hardhat run scripts/check-deployment.ts",
    "contracts:node": "hardhat node",
    "test:contract": "hardhat test",
    "test:unit": "node --experimental-strip-types test/trustGraph.test.ts",
    "test": "hardhat test && node --experimental-strip-types test/trustGraph.test.ts",
    "test:e2e": "e2e run",
    "deploy": "node scripts/deploy.cjs",
    "deploy:work": "node scripts/deploy.cjs work",
    "preview": "vite preview",
    "graphify": "python -m graphify extract . --code-only && python -m graphify cluster-only .",
    "graphify:update": "python -m graphify update .",
    "graphify:query": "python -m graphify query"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.62.8",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwind-merge": "^2.5.5",
    "three": "^0.186.1",
    "viem": "^2.57.4",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.14.0",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "e2e": "^0.19.0",
    "hardhat": "^3.19.0",
    "postcss": "^8.4.49",
    "solc": "^0.8.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
