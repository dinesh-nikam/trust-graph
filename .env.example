# TrustGraph — Environment Variables Example
# Do not commit private keys, secrets, or actual .env files to the repository.

# ------------------------------------------------------------------------------
# Backend & MongoDB Configuration
# ------------------------------------------------------------------------------
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/trustgraph
JWT_SECRET=replace-with-a-secure-random-jwt-secret
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend & Blockchain Configuration (Vite)
# ------------------------------------------------------------------------------
# Monad Testnet RPC URL
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployed TrustGraphRegistry Contract Address on Monad Testnet (Chain ID: 10143)
VITE_TRUST_GRAPH_REGISTRY_ADDRESS=0x2974750CDBc443f4c2cBe8cDb5A79169dB23654E

# Optional: ProofOfWorkRegistry Contract Address (if deployed on Monad Testnet)
VITE_PROOF_OF_WORK_REGISTRY_ADDRESS=

# Backend API endpoint consumed by the frontend
VITE_API_URL=http://localhost:5001

# Application execution mode: 'live' (default) or 'demo'
VITE_APP_MODE=live

# ------------------------------------------------------------------------------
# Contract deployment tooling (server-side only — NEVER commit real values)
# ------------------------------------------------------------------------------
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYER_PRIVATE_KEY=replace-with-testnet-deployer-private-key
MONAD_CHAIN_ID=10143
