# TrustGraph — Environment Variables Example
# Do not commit private keys, secrets, or actual .env files to the repository.

# Monad Testnet RPC URL
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Set only after deploying TrustGraphRegistry and confirming non-empty bytecode on Monad Testnet.
VITE_TRUST_GRAPH_REGISTRY_ADDRESS=

# Application execution mode: 'demo' or 'live'
VITE_APP_MODE=live

# ------------------------------------------------------------------------------
# Contract deployment (server-side tooling — NEVER commit real values)
# Copy this file to .env and fill in before running `npm run contracts:deploy:testnet`.
# Alternative for the private key: `npx hardhat keystore set DEPLOYER_PRIVATE_KEY`.
# Use a dedicated testnet-only wallet funded with small amounts of MON.
# ------------------------------------------------------------------------------

# Monad Testnet RPC endpoint used by Hardhat deployment/verification scripts
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Private key of the deployer wallet (testnet only — never use a mainnet key)
DEPLOYER_PRIVATE_KEY=replace-with-testnet-deployer-private-key

# Monad Testnet chain id (validated before any transaction is sent)
MONAD_CHAIN_ID=10143
