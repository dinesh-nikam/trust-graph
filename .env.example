# TrustGraph — Environment Variables Example
# Do not commit private keys, secrets, or actual .env files to the repository.

# Monad Testnet RPC URL
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployed TrustGraphRegistry Contract Address on Monad Testnet (Chain ID: 10143)
VITE_TRUST_GRAPH_REGISTRY_ADDRESS=0x4386926019A8B74431eBDeF7c2718E340621B903

# Application execution mode: 'mock' or 'live'
VITE_APP_MODE=live
