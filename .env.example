# TrustGraph — Environment Variables Example
# Do not commit private keys, secrets, or actual .env files to the repository.

# Monad Testnet RPC URL
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Set only after deploying TrustGraphRegistry and confirming non-empty bytecode on Monad Testnet.
VITE_TRUST_GRAPH_REGISTRY_ADDRESS=

# Application execution mode: 'demo' or 'live'
VITE_APP_MODE=live
